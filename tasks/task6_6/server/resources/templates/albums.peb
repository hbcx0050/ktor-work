{# Task 6.6 #}
{% extends "base.peb" %}
{% block main %}
<h1>Albums</h1>
{# Write code here to display album details in a table #}
{# Table columns should be artist name, album title, year of release #}
<table>
  <thead>
    <tr>
      <th scope="col">Artist</th>
      <th scope="col">Title</th>
      <th scope="col">Year</th>
    </tr>
  </thead>
  <tbody>
    {% for album in albums %}
      <tr>
        <td>{{ album.artist.name }}</td>
        <td>{{ album.title }}</td>
        <td>{{ album.year }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
